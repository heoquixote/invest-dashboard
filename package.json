{
  "name": "invest-dashboard",
  "version": "1.0.0",
  "description": "해외/국내 주식, ETF, 금, 코인 시세를 모니터링하는 투자 대시보드",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"nodemon --ignore data/ server/index.js\" \"vite\"",
    "dev:server": "nodemon --ignore data/ server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "yahoo-finance2": "^2.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "vite": "^5.4.0"
  }
}
